# Exemple de configuration serveur Podman (/etc/nicolabz-identity/identity.env)
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://auth.nicolabz.dev
DATABASE_PATH=/app/data/identity.sqlite
GOOGLE_CLIENT_ID=REMPLACER.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REMPLACER
TOKEN_ENCRYPTION_KEY_BASE64=REMPLACER
# Le client interne « demo » est réservé et ajouté automatiquement (origine PUBLIC_BASE_URL).
CLIENT_APPS_JSON=[{"id":"todo","origins":["https://todo.nicolabz.dev"]},{"id":"budget","origins":["https://budget.nicolabz.dev"]},{"id":"cooking","origins":["https://cooking.nicolabz.dev"]}]
ALLOWED_EMAILS=
SESSION_DAYS=14
