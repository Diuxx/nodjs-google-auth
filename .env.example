# Copy to .env and fill in the required values. Never commit .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/identity.sqlite
GOOGLE_CLIENT_ID=REMPLACER.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REMPLACER
# Generate a key with npm run secret for a new installation; preserve existing keys.
TOKEN_ENCRYPTION_KEY_BASE64=REMPLACER
# Use exact, unique origins; replace the example Pécule origin with its actual local origin.
# requiresDrive: true requests Drive at login; false or omitted requests identity only.
# multiple: true enables named JSON files; false or omitted keeps single-file mode.
# The two boolean options are independent. Drive can also be authorized separately.
# The demo app and PUBLIC_BASE_URL origin are reserved and added automatically.
CLIENT_APPS_JSON=[{"id":"todo","origins":["http://localhost:4173"]},{"id":"budget","origins":["http://localhost:4174"],"requiresDrive":false,"multiple":false},{"id":"pecule","origins":["http://localhost:4175"],"requiresDrive":true,"multiple":true}]
# Empty allows all Google accounts with verified email, subject to Google consent settings.
ALLOWED_EMAILS=
# Session duration in days (1-90).
SESSION_DAYS=14
