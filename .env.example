# Copie vers .env, puis renseigne les valeurs ; NE COMMITE PAS .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/identity.sqlite
GOOGLE_CLIENT_ID=REMPLACER.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REMPLACER
# npm run secret -> clé aléatoire de 32 octets encodée en base64
TOKEN_ENCRYPTION_KEY_BASE64=REMPLACER
# Origines précises ; une application peut exposer plusieurs origines.
# Le client interne « demo » est réservé et ajouté automatiquement (origine PUBLIC_BASE_URL).
CLIENT_APPS_JSON=[{"id":"todo","origins":["http://localhost:4173"]},{"id":"budget","origins":["http://localhost:4174"]}]
# Optionnel : vide pour autoriser tous les comptes Google avec e-mail vérifié.
ALLOWED_EMAILS=
SESSION_DAYS=14
